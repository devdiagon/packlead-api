# Copy to .env.dev.local for `docker compose up` (postgres + api, local dev).
# The Postgres connection string is already set in docker-compose.yml itself since it points
# at the local `postgres` service with non-secret dev credentials

Firebase__ProjectId=__SET_ME__

# DO NOT CHANGE this path; it is mounted into the container by docker-compose.yml. The file itself should be located at secrets/firebase-service-account.json in the project root
Firebase__ServiceAccountPath=/app/firebase-service-account.json
